{
  "name": "mk.it",
  "version": "0.0.0",
  "private": true,
  "description": "Private browser-based conversion, OCR, base64, and archive toolkit",
  "author": "PortalRunner",
  "type": "module",
  "main": "src/electron.cjs",
  "scripts": {
    "postinstall": "bun run scripts/extract-material-icons.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "cache:build": "bun run buildCache.js dist/cache.json --minify",
    "cache:build:dev": "bun run buildCache.js dist/cache.json",
    "preview": "vite preview",
    "docker": "bun run docker:build && bun run docker:up",
    "docker:build": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml build --build-arg VITE_COMMIT_SHA=$(git rev-parse HEAD)",
    "docker:up": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.override.yml up -d",
    "desktop:build": "tsc && IS_DESKTOP=true vite build && bun run cache:build",
    "desktop:preview": "electron .",
    "desktop:start": "bun run desktop:build && bun run desktop:preview",
    "desktop:dist:win": "bun run desktop:build && electron-builder --win --publish never",
    "desktop:dist:mac": "bun run desktop:build && electron-builder --mac --publish never",
    "desktop:dist:linux": "bun run desktop:build && electron-builder --linux --publish never",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "bun test test/TraversionGraph.test.ts test/commonFormats.test.ts test/tooling.test.ts test/ui.test.ts test/handlers/config.test.ts test/combined-markdown.test.ts test/shared-archive.test.ts test/sevenzip-preview.test.ts test/upstream-sync.test.ts"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "@aiden0z/pptx-renderer": "^1.3.0",
    "@bjorn3/browser_wasi_shim": "^0.4.2",
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@flo-audio/reflo": "^0.1.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@imagemagick/magick-wasm": "^0.0.44",
    "@mediabunny/aac-encoder": "^1.61.1",
    "@mediabunny/flac-encoder": "^1.61.1",
    "@mediabunny/mp3-encoder": "^1.61.1",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@preact/signals": "^2.11.3",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@stringsync/vexml": "^0.1.12",
    "@tesseract.js-data/eng": "1.0.0",
    "@tippyjs/react": "^4.2.6",
    "@toon-format/toon": "^4.1.1",
    "@types/bun": "^1.4.2",
    "@types/meyda": "^5.3.0",
    "@types/pako": "^3.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "@vexflow-fonts/academico": "^1.0.1",
    "@vexflow-fonts/bravura": "^1.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "@yowasp/clang": "^22.0.0-git20542-10",
    "bson": "^7.3.3",
    "buffer": "^6.0.3",
    "celaria-formats": "^1.0.2",
    "chess.js": "^1.4.0",
    "comlink": "^4.4.2",
    "confbox": "^0.3.1",
    "dom-to-svg": "^0.12.2",
    "epubjs": "^0.3.93",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "imagetracer": "^0.2.2",
    "js-synthesizer": "^1.13.0",
    "json5": "^2.2.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "less": "^4.9.1",
    "linkedom": "^0.18.13",
    "lucide-preact": "^1.52.0",
    "marked": "^18.0.12",
    "mediabunny": "^1.61.1",
    "meyda": "^5.6.3",
    "mime": "^4.1.0",
    "nanotar": "^0.3.0",
    "nbtify": "^2.2.0",
    "opentype.js": "^2.0.0",
    "pako": "^3.0.2",
    "papaparse": "^5.7.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pdfkit": "^0.20.2",
    "pe-library": "^2.0.1",
    "preact": "^11.0.0",
    "sass": "^1.105.1",
    "svg-pathdata": "^9.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "three": "^0.186.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.15",
    "tippy.js": "^6.3.7",
    "ts-flp": "^1.0.6",
    "turbowarp-packager-browser": "3.11.1",
    "use-debounce": "^10.1.1",
    "verovio": "^6.3.0",
    "vexflow": "^5.0.0",
    "vite-plugin-static-copy": "^3.4.0",
    "wabt": "^1.0.39",
    "wavefile": "^11.0.0",
    "woff2-encoder": "^2.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@preact/preset-vite": "^2.10.6",
    "@types/jszip": "^3.4.1",
    "@types/less": "^3.0.8",
    "@types/opentype.js": "^1.3.10",
    "@types/pdfkit": "^0.17.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxc-parser": "^0.153.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "puppeteer": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "overrides": {
    "electron": "^44.5.1",
    "extract-zip": "^2.0.1"
  },
  "lint-staged": {
    "*": "bun run fmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "bun run lint --no-error-on-unmatched-pattern"
  },
  "build": {
    "appId": "sh.shel.mk",
    "executableName": "mk-it",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/electron.cjs",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "productName": "mk.it"
}
